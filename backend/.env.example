ENV=dev
LLM_MOCK=false
LLM_TIMEOUT_SECONDS=20
# Pick ONE MongoDB:
# - Docker (docker compose up -d mongo): application user from database/00-create-user.js, never root.
#   Password = MONGO_APP_PASSWORD and port = MONGO_PORT in ../.env.
MONGODB_URI=mongodb://mediflow_app:change-me-app@localhost:27017/mediflow?authSource=mediflow
# - Local MongoDB service without auth (schema: mongosh "mongodb://localhost:27017/mediflow" ../database/mongo-init.js):
# MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=mediflow
CORS_ORIGINS=http://localhost:4200
EXPOSE_TEMPLATE=true

# Authentification (JWT). ENV=prod exige un secret réel d'au moins 32 caractères.
# Valeur factice : à changer localement avant toute utilisation réelle.
JWT_SECRET=CHANGE-ME-use-a-local-secret-of-at-least-32-characters
JWT_EXPIRE_MINUTES=60

# Mot de passe des comptes créés par scripts/seed.py (vide = MediFlow2026!, dev uniquement)
SEED_PASSWORD=

# Responsable : Amal
DOCUMENTS_LLM_PROVIDER=openai_compatible
DOCUMENTS_LLM_BASE_URL=https://api.groq.com/openai/v1
DOCUMENTS_LLM_MODEL=llama3-70b-8192
DOCUMENTS_LLM_API_KEY=

# Responsable : à compléter
TEMPLATE_LLM_PROVIDER=mock
TEMPLATE_LLM_BASE_URL=
TEMPLATE_LLM_MODEL=
TEMPLATE_LLM_API_KEY=
