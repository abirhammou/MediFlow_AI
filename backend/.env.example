ENV=dev
# true: no LLM is called (canned answers); false to use the models below.
LLM_MOCK=true
LLM_TIMEOUT_SECONDS=30

# Shared LiteLLM client (app/llm/client.py), used by the patient summary.
# IDs are prefixed by the provider; switching provider only changes these lines.
# Groq only: LLM_MODEL=groq/openai/gpt-oss-120b and LLM_FALLBACK_MODELS= (empty).
LLM_MODEL=gemini/gemini-3.8-flash
# Comma-separated, tried in order when the primary model fails.
LLM_FALLBACK_MODELS=groq/openai/gpt-oss-120b
# Key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Key from the Groq console: https://console.groq.com/keys
GROQ_API_KEY=
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
# Thinking models (Gemini 3+): minimal, low, medium, high, or empty for the provider default.
LLM_REASONING_EFFORT=low
# Check the keys: .\.venv\Scripts\python -m scripts.llm_smoke_test

# Pick ONE MongoDB:
# - Docker (docker compose up -d mongo): application user from database/00-create-user.js, never root.
#   Password = MONGO_APP_PASSWORD and port = MONGO_PORT in ../.env.
MONGODB_URI=mongodb://mediflow_app:change-me-app@localhost:27017/mediflow?authSource=mediflow
# - Local MongoDB service without auth (schema: mongosh "mongodb://localhost:27017/mediflow" ../database/mongo-init.js):
# MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=mediflow
CORS_ORIGINS=http://localhost:4200
EXPOSE_TEMPLATE=true

# Authentification (JWT). ENV=prod exige un secret réel d'au moins 32 caractères.
# Valeur factice : à changer localement avant toute utilisation réelle.
JWT_SECRET=CHANGE-ME-use-a-local-secret-of-at-least-32-characters
JWT_EXPIRE_MINUTES=60

# Mot de passe des comptes créés par scripts/seed.py (vide = MediFlow2026!, dev uniquement)
SEED_PASSWORD=

# Responsable : Amal
DOCUMENTS_LLM_PROVIDER=mock
DOCUMENTS_LLM_BASE_URL=
DOCUMENTS_LLM_MODEL=
DOCUMENTS_LLM_API_KEY=

# Responsable : à compléter
TEMPLATE_LLM_PROVIDER=mock
TEMPLATE_LLM_BASE_URL=
TEMPLATE_LLM_MODEL=
TEMPLATE_LLM_API_KEY=

# Responsable : Abir
REPORTS_LLM_PROVIDER=openai_compatible
REPORTS_LLM_BASE_URL=https://api.groq.com/openai/v1
REPORTS_LLM_MODEL=openai/gpt-oss-20b
REPORTS_LLM_API_KEY=
# Responsable : Saoussen
APPOINTMENTS_LLM_PROVIDER=mock
APPOINTMENTS_LLM_BASE_URL=
APPOINTMENTS_LLM_MODEL=
APPOINTMENTS_LLM_API_KEY=
