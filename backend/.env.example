ENV=dev
LLM_MOCK=true
LLM_TIMEOUT_SECONDS=20
# Application user from database/00-create-user.js, never root.
# Password = MONGO_APP_PASSWORD in ../.env. Without Docker (local MongoDB, no auth): mongodb://localhost:27017
MONGODB_URI=mongodb://mediflow_app:change-me-app@localhost:27017/mediflow?authSource=mediflow
MONGODB_DB=mediflow
CORS_ORIGINS=http://localhost:4200
EXPOSE_TEMPLATE=true

# Responsable : Amal
DOCUMENTS_LLM_PROVIDER=mock
DOCUMENTS_LLM_BASE_URL=
DOCUMENTS_LLM_MODEL=
DOCUMENTS_LLM_API_KEY=

# Responsable : à compléter
TEMPLATE_LLM_PROVIDER=mock
TEMPLATE_LLM_BASE_URL=
TEMPLATE_LLM_MODEL=
TEMPLATE_LLM_API_KEY=
