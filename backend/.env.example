LLM_MOCK=true
LLM_TIMEOUT_SECONDS=20
MONGO_URI=mongodb://localhost:27017
MONGO_DB=mediflow
CORS_ORIGINS=http://localhost:4200
EXPOSE_TEMPLATE=true

# Mode de l'application : development ou production.
APP_ENV=development
# Valeur factice : à changer localement avant toute utilisation réelle.
JWT_SECRET=CHANGE-ME-use-a-local-secret-of-at-least-32-characters
JWT_EXPIRE_MINUTES=60
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Responsable : Amal
DOCUMENTS_LLM_PROVIDER=mock
DOCUMENTS_LLM_BASE_URL=
DOCUMENTS_LLM_MODEL=
DOCUMENTS_LLM_API_KEY=

# Responsable : à compléter
TEMPLATE_LLM_PROVIDER=mock
TEMPLATE_LLM_BASE_URL=
TEMPLATE_LLM_MODEL=
TEMPLATE_LLM_API_KEY=
