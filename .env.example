# Docker Compose settings. Copy to .env (never commit .env).
# Use letters and digits only: these values are inserted into MongoDB URLs.

# MongoDB root account (init scripts and mongo-express only, never the API)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root

# Application account created by database/00-create-user.js.
# Must match the password in backend/.env (MONGODB_URI).
MONGO_APP_PASSWORD=change-me-app

# mongo-express login (docker compose --profile tools up -d)
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=change-me-express
